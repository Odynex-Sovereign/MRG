from __future__ import annotations

import asyncio
import json
from pathlib import Path
from typing import Any

from fastapi import FastAPI, HTTPException, Request, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse, JSONResponse
from fastapi.staticfiles import StaticFiles

from mrg import __version__
from mrg.config import Settings, get_settings
from simulation import SimulationSession, run_sandbox_simulation

ROOT_DIR = Path(__file__).resolve().parents[1]
STATIC_DIR = ROOT_DIR / "static"
MAX_WS_MESSAGE_BYTES = 256 * 1024
MAX_WS_CONNECTIONS = 200


def _page(name: str) -> FileResponse:
    candidate = ROOT_DIR / name
    if candidate.is_file():
        return FileResponse(candidate, media_type="text/html; charset=utf-8")
    raise HTTPException(status_code=404, detail=f"Page not found: {name}")


def create_app(settings: Settings | None = None) -> FastAPI:
    settings = settings or get_settings()
    app = FastAPI(
        title=settings.app_name,
        version=__version__,
        description="MRG simulation suite for practice, onboarding, and sandbox scenario drills.",
        docs_url="/docs" if settings.environment != "production" else None,
        redoc_url="/redoc" if settings.environment != "production" else None,
        openapi_url="/openapi.json" if settings.environment != "production" else None,
    )
    app.state.settings = settings
    app.state.ws_connections = set()

    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origin_list,
        allow_credentials=True,
        allow_methods=["GET", "POST", "OPTIONS", "HEAD"],
        allow_headers=["*"],
    )

    if STATIC_DIR.is_dir():
        app.mount("/static", StaticFiles(directory=str(STATIC_DIR)), name="static")

    @app.get("/healthz")
    @app.get("/livez")
    async def healthz() -> dict[str, Any]:
        return {
            "status": "ok",
            "version": __version__,
            "environment": settings.environment,
            "billing_configured": settings.billing_configured,
            "engine": "MRG Integrated Simulation Suite",
        }

    @app.get("/readyz")
    async def readyz() -> dict[str, Any]:
        return {
            "status": "ready",
            "version": __version__,
            "billing_configured": settings.billing_configured,
            "websocket_enabled": settings.enable_websocket_simulation,
            "static_ok": STATIC_DIR.is_dir(),
        }

    @app.get("/api/version")
    async def api_version() -> dict[str, Any]:
        return {"version": __version__, "name": settings.app_name}

    @app.get("/api/pricing")
    async def api_pricing() -> dict[str, Any]:
        return {
            "currency": "USD",
            "plans": [
                {"id": "free", "name": "Free", "monthly_usd": 0, "features": ["3 simulations/month"], "entitlements": {"max_simulations_per_month": 3}},
                {"id": "personal", "name": "Personal", "monthly_usd": 5, "annual_usd": 50, "features": ["Black Swan challenges"], "entitlements": {"black_swan_challenges": True}},
                {"id": "pro", "name": "Pro", "monthly_usd": 15, "annual_usd": 150, "features": ["Advanced workflows"], "entitlements": {"max_simulations_per_month": 250}},
                {"id": "enterprise", "name": "Enterprise", "monthly_usd": None, "features": ["Custom agreements"], "entitlements": {"custom_terms": True}},
            ],
            "notes": ["Illustrative pricing only.", "Taxes may apply."],
        }

    @app.post("/api/feedback")
    async def api_feedback(request: Request) -> JSONResponse:
        try:
            payload = await request.json()
        except Exception:
            return JSONResponse({"detail": "Invalid JSON body."}, status_code=400)
        if not isinstance(payload, dict):
            return JSONResponse({"detail": "JSON body must be an object."}, status_code=400)
        message = str(payload.get("message", "")).strip()
        if not message:
            return JSONResponse({"detail": "Message is required."}, status_code=400)
        return JSONResponse({"status": "received", "message": "Thank you. We review feedback regularly."})

    @app.websocket("/ws/simulation")
    async def websocket_simulation(websocket: WebSocket):
        if not settings.enable_websocket_simulation:
            await websocket.close(code=1008)
            return

        if len(app.state.ws_connections) >= MAX_WS_CONNECTIONS:
            await websocket.close(code=1013)
            return

        app.state.ws_connections.add(websocket)
        try:
            await websocket.accept()
            await websocket.send_json({"type": "SYSTEM_STATUS", "payload": {"message": "Connected to the MRG simulation service."}})
            while True:
                raw = await websocket.receive_text()
                if len(raw.encode("utf-8")) > MAX_WS_MESSAGE_BYTES:
                    await websocket.send_json({"type": "SYSTEM_ERROR", "payload": {"message": "Message exceeds size limit."}})
                    continue
                try:
                    payload = json.loads(raw)
                except json.JSONDecodeError:
                    await websocket.send_json({"type": "SYSTEM_ERROR", "payload": {"message": "Invalid JSON frame received."}})
                    continue
                if not isinstance(payload, dict):
                    await websocket.send_json({"type": "SYSTEM_ERROR", "payload": {"message": "A JSON object is required."}})
                    continue

                action = payload.get("action")
                if action == "start":
                    scenario_id = str(payload.get("scenario") or "black_swan_supply")
                    session = SimulationSession()
                    async for event in run_sandbox_simulation(session, scenario_id):
                        await websocket.send_json(event)
                    continue

                if action == "TRIGGER_CRISIS":
                    prompt = str(payload.get("prompt") or "MRG sandbox simulation")
                    await websocket.send_json({"type": "MACRO_COGNITIVE_UPDATE", "payload": {"analysis": f"[Sandbox mode] Simulating macro response for: {prompt}"}})
                    await websocket.send_json({"type": "SENSORY_STREAM_INFO", "payload": {"audio_chunk_size": 128, "status": "streaming"}})
                    continue

                await websocket.send_json({"type": "SYSTEM_ERROR", "payload": {"message": f"Unknown execution target: {action}"}})
        except WebSocketDisconnect:
            pass
        except Exception:
            await websocket.send_json({"type": "SYSTEM_ERROR", "payload": {"message": "Simulation request failed; check application logs."}})
        finally:
            app.state.ws_connections.discard(websocket)

    routes = {
        "/": "index.html",
        "/pricing": "pricing.html",
        "/onboarding": "onboarding.html",
        "/dashboard": "dashboard.html",
        "/institutions": "institutions.html",
        "/demo": "demo.html",
        "/faq": "faq.html",
        "/security": "security.html",
        "/accessibility": "accessibility.html",
        "/contact": "contact.html",
        "/legal/terms": "legal_terms.html",
        "/legal/privacy": "legal_privacy.html",
    }

    for route, filename in routes.items():
        @app.get(route, include_in_schema=False)
        async def render_page(path: str = filename):
            return _page(path)

    @app.get("/favicon.ico", include_in_schema=True)
    async def favicon() -> FileResponse:
        icon = ROOT_DIR / "static" / "icons" / "favicon.svg"
        if icon.is_file():
            return FileResponse(icon, media_type="image/svg+xml")
        return FileResponse(ROOT_DIR / "favicon.svg", media_type="image/svg+xml")

    @app.exception_handler(Exception)
    async def unhandled_exception(request: Request, exc: Exception):
        return JSONResponse({"detail": "Internal server error", "type": type(exc).__name__}, status_code=500)

    return app


app = create_app()
